{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account data",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "maxLength": 255 },
        "role": { "type": "string", "enum": ["user", "admin"], "maxLength": 10 },
        "balance": { "type": "number", "minimum": 0 },
        "totalSpent": { "type": "number", "minimum": 0 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["email", "role", "balance", "totalSpent", "createdAt", "updatedAt"]
    },
    "Service": {
      "title": "Service",
      "description": "SMM Service",
      "type": "object",
      "properties": {
        "platform": { "type": "string", "maxLength": 50 },
        "category": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "price": { "type": "number", "minimum": 0 },
        "minOrder": { "type": "number", "minimum": 1 },
        "maxOrder": { "type": "number", "minimum": 1 },
        "status": { "type": "string", "enum": ["active", "inactive"], "maxLength": 20 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["platform", "category", "name", "price", "minOrder", "maxOrder", "status", "createdAt", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "User order",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "serviceId": { "type": "string", "maxLength": 128 },
        "link": { "type": "string", "maxLength": 1024 },
        "quantity": { "type": "number", "minimum": 1 },
        "charge": { "type": "number", "minimum": 0 },
        "status": { "type": "string", "enum": ["Pending", "Accepted", "Processing", "In Progress", "Completed", "Partial", "Cancelled", "Refunded", "Failed"], "maxLength": 30 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "serviceId", "link", "quantity", "charge", "status", "createdAt", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Wallet transaction",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["deposit", "refund", "charge"], "maxLength": 20 },
        "status": { "type": "string", "enum": ["pending", "completed", "failed"], "maxLength": 20 },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "amount", "type", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles and balances"
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/Service" },
      "description": "Stores all platform services"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Stores all orders"
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Stores wallet transactions"
    }
  }
}
